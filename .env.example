# Copy this file to `.env` in the same directory and fill in real values:
#   cp .env.example .env        (or just copy/paste + rename on Windows)
#
# .env is git-ignored on purpose — it's never committed, so every clone and
# every branch you pull needs its own copy added back manually. This example
# file IS committed and is the reference for which variables exist.
#
# Properties syntax: KEY=VALUE, no quotes, no `export`.

# --- Database ---
DB_USERNAME=
DB_PASSWORD=
# optional for local dev (defaults to the local MySQL URL), required in
# production — full JDBC URL, e.g.
# jdbc:mysql://<host>:3306/<db>?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_URL=

# --- RabbitMQ ---
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
# only needed when pointing at a remote broker (e.g. CloudAMQP) — leave
# empty for a plain local RabbitMQ
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_VHOST=
RABBITMQ_SSL_ENABLED=

# --- JWT --- (HS256 needs >= 256 bits / 32+ random chars)
JWT_SECRET=

# --- Mail (SMTP) --- Gmail: use an App Password, not the account password.
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Brevo transactional email API key --- actually used to send email
# (over HTTPS, since Render's free tier blocks outbound SMTP ports).
BREVO_API_KEY=

# --- Captcha (reCAPTCHA) server-side secret key ---
CAPTCHA_SECRET_KEY=

# --- CORS ---
# optional for local dev (defaults to the localhost/LAN patterns), required
# in production — comma-separated list of full allowed origins, e.g.
# https://camtel-app.onrender.com
CORS_ALLOWED_ORIGINS=
