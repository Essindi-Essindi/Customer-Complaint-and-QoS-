# Copy this file to `.env` in the same directory and fill in real values:
#   cp .env.example .env        (or just copy/paste + rename on Windows)
#
# .env is git-ignored on purpose — it's never committed, so every clone and
# every branch you pull needs its own copy added back manually. This example
# file IS committed and is the reference for which variables exist.
#
# Properties syntax: KEY=VALUE, no quotes, no `export`.

# --- Database ---
DB_USERNAME=
DB_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# --- JWT --- (HS256 needs >= 256 bits / 32+ random chars)
JWT_SECRET=

# --- Mail (SMTP) --- Gmail: use an App Password, not the account password.
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Captcha (reCAPTCHA) server-side secret key ---
CAPTCHA_SECRET_KEY=
