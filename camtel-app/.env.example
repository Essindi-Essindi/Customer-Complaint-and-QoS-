# Copy this file to `.env` in this same folder (camtel-app/.env) and adjust.
# .env is git-ignored — every clone/branch needs its own copy, added back
# manually. This example file is the one that's actually committed.
# Vite only exposes vars prefixed VITE_ to the browser — see src/lib/api.ts
# and src/components/Recaptcha.tsx for where each of these is read.

# Base URL for the Spring Boot backend's /api routes.
VITE_API_BASE_URL=http://localhost:8080/api

# Optional — only needed once a real reCAPTCHA site key is issued for
# staging/production. Left unset, Register/SubmitComplaint fall back to
# Google's public TEST site key (always verifies, fine for local dev).
VITE_RECAPTCHA_SITE_KEY=
